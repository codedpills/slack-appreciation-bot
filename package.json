{
  "name": "slack-appreciation-bot",
  "version": "1.0.0",
  "description": "A Slack bot for peer-to-peer appreciation aligned with company values",
  "main": "dist/app.js",
  "scripts": {
    "build": "tsc",
    "heroku-postbuild": "npm run build",
    "start": "node dist/app.js",
    "dev": "ts-node src/app.ts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f",
    "db:migrate": "node-pg-migrate up --migrations-dir migrations",
    "db:migrate:down": "node-pg-migrate down --migrations-dir migrations",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts",
    "audit:security": "npm audit --production --audit-level=moderate",
    "prestart": "npm run db:migrate"
  },
  "dependencies": {
    "@giphy/js-fetch-api": "^5.3.0",
    "@slack/bolt": "^3.12.2",
    "dotenv": "^16.0.3",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.1.0",
    "pg": "^8.16.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@types/express-rate-limit": "^5.1.3",
    "@types/jest": "^29.5.0",
    "@types/node": "^18.15.11",
    "@types/pg": "^8.15.2",
    "@typescript-eslint/eslint-plugin": "^5.57.1",
    "@typescript-eslint/parser": "^5.57.1",
    "eslint": "^8.37.0",
    "jest": "^29.5.0",
    "node-pg-migrate": "^8.0.4",
    "pg-mem": "^3.0.5",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.0.3"
  },
  "keywords": [
    "slack",
    "bot",
    "appreciation",
    "recognition",
    "company-values",
    "peer-to-peer",
    "rewards"
  ],
  "author": "codedpills",
  "license": "MIT"
}
